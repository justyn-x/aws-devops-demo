      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 10 },
      "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
      "targets": [{
        "refId": "A",
        "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
        "queryMode": "Metrics",
        "metricQueryType": 0,
        "metricEditorMode": 0,
        "namespace": "AWS/DocDB",
        "metricName": "DatabaseConnections",
        "dimensions": { "DBClusterIdentifier": ["${PREFIX}-docdb"] },
        "statistic": "Sum",
        "period": "300",
        "region": "${REGION}",
        "id": "",
        "expression": "",
        "sqlExpression": "",
        "matchExact": true
      }],
      "fieldConfig": {
        "defaults": { "max": 100, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 30 }, { "color": "red", "value": 50 }] } }
      }
