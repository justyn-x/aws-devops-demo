{
  "uid": "infra-overview",
  "title": "Infrastructure Overview",
  "tags": ["infra"],
  "timezone": "browser",
  "panels": [
    {
      "title": "API Gateway",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "title": "Request Count",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
      "targets": [{
        "refId": "A",
        "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
        "queryMode": "Metrics",
        "metricQueryType": 0,
        "metricEditorMode": 0,
        "namespace": "AWS/ApiGateway",
        "metricName": "Count",
        "dimensions": {},
        "statistic": "Sum",
        "period": "300",
        "region": "${REGION}",
        "id": "",
        "expression": "",
        "sqlExpression": "",
        "matchExact": true,
        "label": "Requests"
      }],
      "fieldConfig": {
        "defaults": { "custom": { "fillOpacity": 20, "lineWidth": 2, "drawStyle": "bars" }, "color": { "fixedColor": "blue", "mode": "fixed" } }
      }
    },
    {
      "title": "Error Rates (4xx / 5xx)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "namespace": "AWS/ApiGateway",
          "metricName": "4xx",
          "dimensions": {},
          "statistic": "Sum",
          "period": "300",
          "region": "${REGION}",
          "id": "",
          "expression": "",
          "sqlExpression": "",
          "matchExact": true,
          "label": "4xx"
        },
        {
          "refId": "B",
          "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "namespace": "AWS/ApiGateway",
          "metricName": "5xx",
          "dimensions": {},
          "statistic": "Sum",
          "period": "300",
          "region": "${REGION}",
          "id": "",
          "expression": "",
          "sqlExpression": "",
          "matchExact": true,
          "label": "5xx"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "5xx" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "4xx" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] }
        ]
      }
    },
    {
      "title": "Latency (p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
      "targets": [{
        "refId": "A",
        "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
        "queryMode": "Metrics",
        "metricQueryType": 0,
        "metricEditorMode": 0,
        "namespace": "AWS/ApiGateway",
        "metricName": "Latency",
        "dimensions": {},
        "statistic": "p99",
        "period": "300",
        "region": "${REGION}",
        "id": "",
        "expression": "",
        "sqlExpression": "",
        "matchExact": true,
        "label": "p99"
      }],
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "fillOpacity": 10, "lineWidth": 2 }, "color": { "fixedColor": "purple", "mode": "fixed" } }
      }
    },
    {
      "title": "DocumentDB",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "collapsed": false
    },
    {
      "title": "CPU Utilization (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 10 },
      "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
      "targets": [{
        "refId": "A",
        "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
        "queryMode": "Metrics",
        "metricQueryType": 0,
        "metricEditorMode": 0,
        "namespace": "AWS/DocDB",
        "metricName": "CPUUtilization",
        "dimensions": { "DBClusterIdentifier": ["${PREFIX}-docdb"] },
        "statistic": "Average",
        "period": "300",
        "region": "${REGION}",
        "id": "",
        "expression": "",
        "sqlExpression": "",
        "matchExact": true
      }],
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "fillOpacity": 10, "lineWidth": 2 },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 60 }, { "color": "red", "value": 80 }] }
        }
      }
    },
    {
