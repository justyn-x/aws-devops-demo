{
  "uid": "service-overview",
  "title": "Service Overview",
  "tags": ["service"],
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "prefix",
        "type": "constant",
        "query": "${PREFIX}",
        "current": { "text": "${PREFIX}", "value": "${PREFIX}" },
        "hide": 2
      },
      {
        "name": "service",
        "type": "query",
        "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
        "query": "dimension_values(${REGION},AWS/ECS,CPUUtilization,ServiceName)",
        "regex": "/^$prefix-(.+-service)$/",
        "refresh": 1,
        "sort": 1,
        "current": {},
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "title": "ECS Health",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "title": "CPU Utilization (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
      "targets": [{
        "refId": "A",
        "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
        "queryMode": "Metrics",
        "metricQueryType": 0,
        "metricEditorMode": 0,
        "namespace": "AWS/ECS",
        "metricName": "CPUUtilization",
        "dimensions": { "ClusterName": ["$prefix"], "ServiceName": ["$prefix-$service"] },
        "statistic": "Average",
        "period": "300",
        "region": "${REGION}",
        "id": "",
        "expression": "",
        "sqlExpression": "",
        "matchExact": true
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 60 }, { "color": "red", "value": 80 }] },
          "custom": { "fillOpacity": 10, "lineWidth": 2 }
        }
      }
    },
    {
      "title": "Memory Utilization (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
      "targets": [{
        "refId": "A",
        "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
        "queryMode": "Metrics",
        "metricQueryType": 0,
        "metricEditorMode": 0,
        "namespace": "AWS/ECS",
        "metricName": "MemoryUtilization",
        "dimensions": { "ClusterName": ["$prefix"], "ServiceName": ["$prefix-$service"] },
        "statistic": "Average",
        "period": "300",
        "region": "${REGION}",
        "id": "",
        "expression": "",
        "sqlExpression": "",
        "matchExact": true
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 60 }, { "color": "red", "value": 80 }] },
          "custom": { "fillOpacity": 10, "lineWidth": 2 }
        }
      }
    },
    {
      "title": "Running Tasks",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
      "targets": [{
        "refId": "A",
        "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
        "queryMode": "Metrics",
        "metricQueryType": 0,
        "metricEditorMode": 0,
        "namespace": "ECS/ContainerInsights",
        "metricName": "RunningTaskCount",
        "dimensions": { "ClusterName": ["$prefix"], "ServiceName": ["$prefix-$service"] },
        "statistic": "Average",
        "period": "60",
        "region": "${REGION}",
        "id": "",
        "expression": "",
        "sqlExpression": "",
        "matchExact": true
      }],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      }
    },
    {
      "title": "Application Metrics",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "collapsed": false
    },
    {
      "title": "HTTP Request Duration (avg / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "namespace": "AppMetrics/$service",
          "metricName": "http.server.request.duration",
          "dimensions": { "OTelLib": ["go.opentelemetry.io/contrib/instrumentation/net/http/otelhttp"] },
          "statistic": "Average",
          "period": "300",
          "region": "${REGION}",
          "id": "",
          "expression": "",
          "sqlExpression": "",
          "matchExact": true,
          "label": "avg"
        },
        {
          "refId": "B",
          "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "namespace": "AppMetrics/$service",
          "metricName": "http.server.request.duration",
          "dimensions": { "OTelLib": ["go.opentelemetry.io/contrib/instrumentation/net/http/otelhttp"] },
          "statistic": "p99",
          "period": "300",
          "region": "${REGION}",
          "id": "",
          "expression": "",
          "sqlExpression": "",
          "matchExact": true,
          "label": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 10, "lineWidth": 2 } }
      }
    },
    {
      "title": "ALB Error Rates",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "namespace": "AWS/ApplicationELB",
          "metricName": "HTTPCode_Target_5XX_Count",
          "dimensions": {},
          "statistic": "Sum",
          "period": "300",
          "region": "${REGION}",
          "id": "",
          "expression": "",
          "sqlExpression": "",
          "matchExact": false,
          "label": "5xx"
        },
        {
          "refId": "B",
          "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "namespace": "AWS/ApplicationELB",
          "metricName": "HTTPCode_Target_4XX_Count",
          "dimensions": {},
          "statistic": "Sum",
          "period": "300",
          "region": "${REGION}",
          "id": "",
          "expression": "",
          "sqlExpression": "",
          "matchExact": false,
          "label": "4xx"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "5xx" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "4xx" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] }
        ]
      }
    },
    {
      "title": "Traces (X-Ray)",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "collapsed": false
    },
    {
      "title": "Recent Traces",
      "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 19 },
      "datasource": { "type": "grafana-x-ray-datasource", "uid": "xray" },
      "targets": [{
        "refId": "A",
        "datasource": { "type": "grafana-x-ray-datasource", "uid": "xray" },
        "queryType": "getTraceSummaries",
        "query": "service(\"$service\") AND NOT http.url CONTAINS \"healthz\"",
        "region": "${REGION}"
      }]
    },
    {
      "title": "Logs",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 29 },
      "collapsed": false
    },
    {
      "title": "Application Logs",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 30 },
      "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
      "targets": [{
        "refId": "A",
        "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
        "queryMode": "Logs",
        "logGroups": [{ "name": "/ecs/$prefix/$service" }],
        "expression": "fields @timestamp, level, msg, trace_id, caller\n| filter @message not like /healthz/\n| sort @timestamp desc\n| limit 50",
        "region": "${REGION}"
      }]
    }
  ],
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "schemaVersion": 39
}
