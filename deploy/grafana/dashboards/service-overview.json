        "y": 18
      },
      "title": "Traces (X-Ray)",
      "type": "row"
    },
    {
      "datasource": {
        "type": "grafana-x-ray-datasource",
        "uid": "xray"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-x-ray-datasource",
            "uid": "xray"
          },
          "query": "service(\"$service\") AND NOT http.url CONTAINS \"healthz\"",
          "queryType": "getTraceSummaries",
          "refId": "A",
          "region": "${REGION}"
        }
      ],
      "title": "Recent Traces",
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 29
      },
      "title": "Logs",
      "type": "row"
    },
    {
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "targets": [
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "expression": "fields @timestamp, level, msg, trace_id, caller\n| filter @message not like /healthz/\n| sort @timestamp desc\n| limit 50",
          "logGroups": [
            {
              "accountId": "482155437574",
              "arn": "arn:aws:logs:${REGION}:482155437574:log-group:/ecs/$prefix/$service",
              "name": "/ecs/$prefix/$service"
            }
          ],
          "queryMode": "Logs",
          "refId": "A",
          "region": "${REGION}"
        }
      ],
      "title": "Application Logs",
      "type": "logs"
    }
