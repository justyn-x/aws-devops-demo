  "schemaVersion": 39,
  "tags": [
    "service"
  ],
  "templating": {
    "list": [
      {
        "name": "prefix",
        "type": "constant",
        "query": "${PREFIX}",
        "current": {
          "text": "${PREFIX}",
          "value": "${PREFIX}"
        },
        "hide": 2
      },
      {
        "name": "service",
        "type": "custom",
        "query": "todo-service,user-service",
        "current": {
          "text": "todo-service",
          "value": "todo-service",
          "selected": true
        },
        "options": [
          {
            "text": "todo-service",
            "value": "todo-service",
            "selected": true
          },
          {
            "text": "user-service",
            "value": "user-service",
            "selected": false
          }
        ],
        "includeAll": false,
        "hide": 0
      }
