          "metricEditorMode": 1,
          "metricQueryType": 1,
          "namespace": "AWS/ECS",
          "period": "300",
          "queryMode": "Metrics",
          "refId": "A",
          "region": "${REGION}",
          "sqlExpression": "SELECT AVG(CPUUtilization) FROM SCHEMA(\"AWS/ECS\", ClusterName, ServiceName) WHERE ClusterName = '${prefix}' AND ServiceName = '${prefix}-${service}'",
          "statistic": "Average"
        }
